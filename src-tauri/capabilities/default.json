{
  "$schema": "https://schemas.tauri.app/capabilities/3.0.0/schema.json",
  "identifier": "default",
  "description": "Default capabilities for TokenMeow Client",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-set-focus",
    "core:tray:default",
    "core:tray:allow-set-icon",
    "core:tray:allow-set-tooltip",
    "core:menu:default",
    "opener:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-open",
    "process:allow-exit",
    "updater:default"
  ]
}
